meta {
  name: Enable
  type: http
  seq: 1
}

put {
  url: {{baseUrl}}/automix
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": true
  }
}

tests {
  test("enables automix", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ok).to.equal(true);
    expect(res.body.status.automix.enabled).to.equal(true);
  });
}
