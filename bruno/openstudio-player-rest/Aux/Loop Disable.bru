meta {
  name: Loop Disable
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/aux/{{auxId}}/loop
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "enabled": false
  }
}

tests {
  test("disables aux loop", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ok).to.equal(true);
  });
}
