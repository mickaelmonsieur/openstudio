meta {
  name: Seek Backward
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/deck/seek
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "offset_ms": {{seekBackwardMs}}
  }
}

tests {
  test("seeks deck backward", function() {
    expect(res.status).to.equal(200);
    expect(res.body.ok).to.equal(true);
  });
}
